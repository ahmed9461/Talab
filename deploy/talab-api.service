[Unit]
Description=Talab FastAPI
After=network.target postgresql.service

[Service]
User=talab
Group=talab
WorkingDirectory=/opt/Talab/backend
EnvironmentFile=/opt/Talab/backend/.env
ExecStart=/opt/Talab/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
